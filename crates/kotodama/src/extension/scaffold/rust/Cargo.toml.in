[package]
name = "kotodama-{{name}}"
version = "0.1.0"
edition = "2024"
publish = false

# The protocol version the Extension speaks, which both crates' major.minor
# names. A Kotodama that speaks this version or a later one runs it.
[dependencies]
kotodama-extension = "{{protocol}}"
kotodama-protocol = "{{protocol}}"

# An Extension runs as long as the Daemon does, so it is built small.
[profile.release]
lto = true
codegen-units = 1
panic = "abort"
strip = true
