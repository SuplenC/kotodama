# Started by kotodamad.socket. A package fills in the directory it installs
# `kotodamad` in.
[Unit]
Description=Kotodama Daemon
Documentation=https://github.com/SuplenC/kotodama
Requires=kotodamad.socket
After=kotodamad.socket

[Service]
ExecStart=@bindir@/kotodamad
# Every program the Daemon or an Extension starts for the user is a service of
# its own that the user manager starts, so it inherits nothing of this one and
# stopping or restarting the Daemon doesn't kill the user's apps. Setting
# KOTODAMA_LAUNCH_PREFIX here replaces that.
Restart=on-failure
