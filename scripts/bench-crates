#!/usr/bin/env bash
# Prints the crates whose changes can move a benchmark, one directory name under
# crates/ per line: every crate with a benches/ directory, and every workspace
# crate those depend on (see path-deps). CI's `changes` job runs `bench` and
# `instructions` when one of them changed.
# Usage: bench-crates
set -euo pipefail

cd "$(dirname "$0")/.."
benched=()
for dir in crates/*/benches; do
    [ -d "$dir" ] || continue
    crate=${dir#crates/}
    benched+=("${crate%/benches}")
done
if [ ${#benched[@]} -gt 0 ]; then
    scripts/path-deps "${benched[@]}"
fi
