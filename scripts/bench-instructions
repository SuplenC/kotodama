#!/usr/bin/env bash
# Counts the instructions of the gungraun benchmarks (every bench target named
# `instructions`) of the checkout in DIR, in that checkout's dev shell, under
# Valgrind. `save` keeps the counts as the baseline `base`; `compare` compares
# with it, and fails when a benchmark runs more than 5% more instructions than
# it did there. The counts are the same from run to run and on any runner, so
# both checkouts needn't run on one machine. CI's `instructions` job runs the
# base commit with `save` and this one with `compare`; both write to
# GUNGRAUN_HOME, so they find each other's baseline.
# Usage: GUNGRAUN_HOME=... bench-instructions DIR save|compare
set -euo pipefail

dir=$1
mode=$2
case $mode in
    save) args=(--save-baseline=base) ;;
    compare) args=(--baseline=base --callgrind-limits=ir=5%) ;;
    *)
        echo "bench-instructions: the mode is save or compare, not $mode" >&2
        exit 2
        ;;
esac
cd "$dir"
# As in bench-run: two checkouts build into one target directory.
git ls-files -z | xargs -0 touch -h
if ! nix develop --command cargo metadata --no-deps --format-version 1 |
    jq -e 'any(.packages[].targets[]; .kind == ["bench"] and .name == "instructions")' >/dev/null; then
    echo "bench-instructions: $dir has no instruction-counting benchmark."
    exit 0
fi
nix develop --command cargo bench --workspace --bench instructions -- "${args[@]}"
