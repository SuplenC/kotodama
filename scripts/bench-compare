#!/usr/bin/env bash
# Compares two criterion `--output-format bencher` outputs and fails when a
# benchmark is higher than its baseline by more than the threshold. Only lines
# in UNIT are compared: `ns/iter` for timings, or `bytes` for the memory lines
# some benchmarks print in the same format.
# Usage: bench-compare BASELINE CURRENT [THRESHOLD_PERCENT] [UNIT]
set -euo pipefail

baseline=$1 current=$2 threshold=${3:-50} unit=${4:-ns/iter}

if [ ! -f "$baseline" ]; then
    echo "no baseline at $baseline; nothing to compare against"
    exit 0
fi

# "test <name> ... bench: 1,234 <unit> (+/- 5)" -> "<name><TAB>1234", for UNIT only
parse() {
    sed -nE 's|^test (.*) \.\.\. bench: +([0-9,]+) ([^ ]+).*|\1\t\2\t\3|p' "$1" |
        awk -F'\t' -v OFS='\t' -v unit="$unit" '$3 == unit { gsub(/,/, "", $2); print $1, $2 }'
}

awk -F'\t' -v threshold="$threshold" -v unit="$unit" '
    NR == FNR { base[$1] = $2; next }
    {
        if (!($1 in base)) {
            printf "new        %s: %d %s\n", $1, $2, unit
            next
        }
        if ($2 > base[$1] * (1 + threshold / 100)) {
            printf "REGRESSION %s: %d -> %d %s\n", $1, base[$1], $2, unit
            failed = 1
        }
    }
    END { exit failed }
' <(parse "$baseline") <(parse "$current")
