{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "kotodama",
      "include-component-in-tag": false,
      "bump-minor-pre-major": true,
      "extra-files": [
        {
          "type": "toml",
          "path": "Cargo.toml",
          "jsonpath": "$.workspace.package.version"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(@.name.value == 'kotodama' || @.name.value == 'kotodama-apps' || @.name.value == 'kotodama-calculator' || @.name.value == 'kotodama-clipboard' || @.name.value == 'kotodama-emoji' || @.name.value == 'kotodama-extension' || @.name.value == 'kotodama-folders' || @.name.value == 'kotodama-protocol' || @.name.value == 'kotodama-qml' || @.name.value == 'kotodamad')].version"
        }
      ]
    }
  }
}
