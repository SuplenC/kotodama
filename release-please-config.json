      ]
    },
    "crates/kotodama-hyprland": {
      "extra-files": [
        { "type": "toml", "path": "/Cargo.lock", "jsonpath": "$.package[?(@.name.value == 'kotodama-hyprland')].version" }
      ]
    },
    "crates/kotodama-system": {
      "extra-files": [
        { "type": "toml", "path": "/Cargo.lock", "jsonpath": "$.package[?(@.name.value == 'kotodama-system')].version" }
      ]
    },
    "crates/kotodama-web-search": {
      "extra-files": [
        { "type": "toml", "path": "/Cargo.lock", "jsonpath": "$.package[?(@.name.value == 'kotodama-web-search')].version" }
      ]
    }
