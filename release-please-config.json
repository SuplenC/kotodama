{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "rust",
  "bump-minor-pre-major": true,
  "separate-pull-requests": true,
  "plugins": [
    {
      "type": "linked-versions",
      "groupName": "kotodama",
      "components": ["kotodama", "kotodamad"]
    }
  ],
  "packages": {
    "crates/kotodama": {
      "extra-files": [
        { "type": "toml", "path": "/Cargo.lock", "jsonpath": "$.package[?(@.name.value == 'kotodama')].version" }
      ]
    },
    "crates/kotodamad": {
      "extra-files": [
        { "type": "toml", "path": "/Cargo.lock", "jsonpath": "$.package[?(@.name.value == 'kotodamad')].version" }
      ]
    },
    "crates/kotodama-protocol": {
      "extra-files": [
        { "type": "toml", "path": "/Cargo.lock", "jsonpath": "$.package[?(@.name.value == 'kotodama-protocol')].version" }
      ]
    },
    "crates/kotodama-extension": {
      "extra-files": [
        { "type": "toml", "path": "/Cargo.lock", "jsonpath": "$.package[?(@.name.value == 'kotodama-extension')].version" }
      ]
    },
    "crates/kotodama-qml": {
      "extra-files": [
        { "type": "toml", "path": "/Cargo.lock", "jsonpath": "$.package[?(@.name.value == 'kotodama-qml')].version" }
      ]
    },
    "crates/kotodama-ai": {
      "extra-files": [
        { "type": "toml", "path": "/Cargo.lock", "jsonpath": "$.package[?(@.name.value == 'kotodama-ai')].version" }
      ]
    },
    "crates/kotodama-apps": {
      "extra-files": [
        { "type": "toml", "path": "/Cargo.lock", "jsonpath": "$.package[?(@.name.value == 'kotodama-apps')].version" }
      ]
    },
    "crates/kotodama-calculator": {
      "extra-files": [
        { "type": "toml", "path": "/Cargo.lock", "jsonpath": "$.package[?(@.name.value == 'kotodama-calculator')].version" }
      ]
    },
    "crates/kotodama-clipboard": {
      "extra-files": [
        { "type": "toml", "path": "/Cargo.lock", "jsonpath": "$.package[?(@.name.value == 'kotodama-clipboard')].version" }
      ]
    },
    "crates/kotodama-emoji": {
      "extra-files": [
        { "type": "toml", "path": "/Cargo.lock", "jsonpath": "$.package[?(@.name.value == 'kotodama-emoji')].version" }
