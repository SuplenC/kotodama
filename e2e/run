#!/usr/bin/env bash
# Starts headless sway with one fixed output and runs every e2e/*/test.sh against
# it, or only the named ones.
# Usage: e2e/run [--update] [test...]
set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

export E2E_UPDATE=0
if [ "${1:-}" = --update ]; then
    E2E_UPDATE=1
    shift
fi
tests=("$@")
if [ "${#tests[@]}" -eq 0 ]; then
    # E2E_SKIP names tests to leave out of a full run, separated by spaces.
    for test in "$root"/e2e/*/test.sh; do
        name=$(basename "$(dirname "$test")")
        if [[ " ${E2E_SKIP:-} " != *" $name "* ]]; then
            tests+=("$name")
        fi
    done
fi

export E2E_OUT="$root/e2e/out"
rm -rf "$E2E_OUT"
mkdir -p "$E2E_OUT"

XDG_RUNTIME_DIR=$(mktemp -d)
chmod 700 "$XDG_RUNTIME_DIR"
export XDG_RUNTIME_DIR
export WLR_BACKENDS=headless WLR_RENDERER=pixman WLR_LIBINPUT_NO_DEVICES=1 WLR_HEADLESS_OUTPUTS=1
unset WAYLAND_DISPLAY DISPLAY SWAYSOCK

sway -c "$root/e2e/sway.conf" >"$E2E_OUT/sway.log" 2>&1 &
sway_pid=$!
trap 'kill "$sway_pid" 2>/dev/null || true; wait "$sway_pid" 2>/dev/null || true; rm -rf "$XDG_RUNTIME_DIR"' EXIT

for _ in $(seq 100); do
    WAYLAND_DISPLAY=$(find "$XDG_RUNTIME_DIR" -maxdepth 1 -type s -name 'wayland-*' -printf '%f\n' | head -n1)
    SWAYSOCK=$(find "$XDG_RUNTIME_DIR" -maxdepth 1 -type s -name 'sway-ipc.*' | head -n1)
    if [ -n "$WAYLAND_DISPLAY" ] && [ -n "$SWAYSOCK" ]; then
        break
    fi
    if ! kill -0 "$sway_pid" 2>/dev/null; then
        cat "$E2E_OUT/sway.log" >&2
        echo "sway exited during startup" >&2
        exit 1
    fi
    sleep 0.1
done
if [ -z "$WAYLAND_DISPLAY" ] || [ -z "$SWAYSOCK" ]; then
    echo "sway did not start; see $E2E_OUT/sway.log" >&2
    exit 1
fi
export WAYLAND_DISPLAY SWAYSOCK

# Headless sway has no keyboard of its own, so the seat would gain one only
# while some program's virtual keyboard exists, and windows bind theirs only
# then: keys typed before that are lost. This virtual keyboard stays for the
# whole run, as a desktop's keyboard does: wtype makes it, then sleeps for an
# hour, longer than any run.
wtype -s 3600000 &
keyboard_pid=$!
trap 'kill "$keyboard_pid" "$sway_pid" 2>/dev/null || true; wait "$sway_pid" 2>/dev/null || true; rm -rf "$XDG_RUNTIME_DIR"' EXIT
has_keyboard() {
    # 2 is WL_SEAT_CAPABILITY_KEYBOARD.
    swaymsg -t get_seats | jq -e 'any(.[]; .capabilities % 4 >= 2)' >/dev/null
}
for _ in $(seq 100); do
    if has_keyboard; then
        break
    fi
    sleep 0.1
done
if ! has_keyboard; then
    echo "the seat has no keyboard; is wtype there?" >&2
    exit 1
fi
export QT_QPA_PLATFORM=wayland QT_QUICK_BACKEND=software

failed=0
for name in "${tests[@]}"; do
    test="$root/e2e/$name/test.sh"
    # Each test's logs and screenshots go in a directory of their own.
    mkdir -p "$E2E_OUT/$name"
    if (export E2E_OUT="$E2E_OUT/$name" && cd "$(dirname "$test")" && bash -euo pipefail -c 'source "$1/e2e/lib.sh"; source "$2"' _ "$root" "$test"); then
        echo "ok   $name"
    else
        echo "FAIL $name"
        failed=1
    fi
done
exit "$failed"
